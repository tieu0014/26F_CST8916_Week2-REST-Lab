# GET root URL
GET rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/
Accept: text/plain

###

# GET health check
GET rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/health
Accept: application/json

###

# GET all users
GET rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/users
Accept: application/json

###

# GET a specific user by ID
GET rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/users/1
Accept: application/json

###

# POST create a new user
POST rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/users
Content-Type: application/json

{
  "name": "Charlie",
  "age": 22
}

###

# PUT update a user by ID
PUT rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/users/1
Content-Type: application/json

{
  "name": "Alice Updated",
  "age": 26
}

###

# DELETE a user by ID
DELETE rest-frcvexggc8hserca.mexicocentral-01.azurewebsites.net/users/1
